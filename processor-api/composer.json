{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3.4",
        "barryvdh/laravel-dompdf": "^3.1.2",
        "barryvdh/laravel-snappy": "^1.0.5",
        "dedoc/scramble": "^0.13",
        "doctrine/dbal": "^3.10",
        "filament/filament": "~5.0",
        "guzzlehttp/guzzle": "^7.8",
        "laravel/framework": "^12.0",
        "laravel/horizon": "^5.41",
        "laravel/passport": "^12.0",
        "laravel/reverb": "^1.6",
        "laravel/telescope": "^5.16",
        "laravel/tinker": "^2.9",
        "sentry/sentry-laravel": "^4.22",
        "spatie/laravel-permission": "^6.23"
    },
    "require-dev": {
        "fakerphp/faker": "1.23.1",
        "larastan/larastan": "^3.9",
        "laravel/boost": "^2.4",
        "laravel/pint": "1.15.2",
        "laravel/sail": "^1.57",
        "mockery/mockery": "1.6.12",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0",
        "spatie/guidelines-skills": "dev-main",
        "spatie/laravel-ignition": "^2.8"
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.4"
        },
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "files": [
            "app/Helpers/japanese-text-methods.php",
            "app/Helpers/hashtags-methods.php",
            "app/Helpers/impressions-methods.php"
        ],
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "database/seeders",
            "database/factories"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "lint-staged": {
            "**/*.php": [
                "php ./vendor/bin/pint"
            ]
        },
        "openapi": "php artisan scramble:export --path=api.json",
        "format": "vendor/bin/pint --dirty",
        "format:all": "vendor/bin/pint",
        "format:check": "vendor/bin/pint --test",
        "stan": "vendor/bin/phpstan analyse --memory-limit=1G",
        "test:prepare": "php artisan migrate:fresh --force",
        "test": "vendor/bin/phpunit --colors=always",
        "quality": [
            "@format",
            "@stan",
            "@test"
        ],
        "quality:ci": [
            "@format:check",
            "@stan",
            "@test"
        ]
    }
}

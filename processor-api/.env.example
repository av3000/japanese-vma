APP_NAME=Laravel
APP_ENV=local
APP_RELEASE=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=
PASSPORT_PRIVATE_KEY_B64=
PASSPORT_PUBLIC_KEY_B64=
PASSPORT_PERSONAL_ACCESS_CLIENT_ID=
PASSPORT_PERSONAL_ACCESS_CLIENT_SECRET=
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_RELEASE=${APP_RELEASE}
SENTRY_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_PROFILES_SAMPLE_RATE=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=
DB_SSLMODE=prefer
DB_COLLATION=utf8mb4_unicode_ci

BROADCAST_DRIVER=log
CACHE_DRIVER=file
# Production queue workers should use CACHE_DRIVER=redis.
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_CLIENT=phpredis
REDIS_URL=
REDIS_SCHEME=tcp
# or 'redis' from container name
REDIS_HOST=127.0.0.1
REDIS_USERNAME=
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE=default

QUEUE_RETRY_AFTER=180
QUEUE_WORKER_TIMEOUT=150
QUEUE_WORKER_SLEEP=3
QUEUE_WORKER_TRIES=3
QUEUE_WORKER_BACKOFF=15
QUEUE_WORKER_MAX_JOBS=500
QUEUE_WORKER_MAX_TIME=3600

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# Optional release tracking for CI/CD smoke verification and observability.
APP_RELEASE=

# PDF generate library paths, overwrite locally with these if needed, current paths in 'config/snappy.php' are for containers
# WKHTML_PDF_BINARY=/usr/local/bin/wkhtmltopdf
# WKHTML_IMG_BINARY=/usr/local/bin/wkhtmltoimage

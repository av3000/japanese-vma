{
    "preset": "laravel",
    "rules": {
        "blank_line_after_opening_tag": true,
        "class_attributes_separation": {
            "elements": {
                "case": "none",
                "const": "one",
                "method": "one",
                "property": "one",
                "trait_import": "none"
            }
        },
        "no_extra_blank_lines": true,
        "no_superfluous_phpdoc_tags": true,
        "no_unused_imports": true,
        "ordered_imports": {
            "imports_order": [
                "class",
                "function",
                "const"
            ],
            "sort_algorithm": "alpha"
        },
        "phpdoc_align": {
            "align": "left"
        },
        "phpdoc_order": true,
        "phpdoc_scalar": true,
        "phpdoc_separation": true,
        "phpdoc_trim": true,
        "phpdoc_types_order": {
            "null_adjustment": "always_last",
            "sort_algorithm": "none"
        },
        "single_import_per_statement": true
    },
    "exclude": [
        "bootstrap/cache",
        "storage"
    ],
    "notPath": [
        "public/index.php",
        "server.php"
    ]
}

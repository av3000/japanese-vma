{
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": true,
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "jsx": "preserve"
  },
  "include": ["vite.config.ts", "vitest.config.ts", ".storybook/main.ts", ".storybook/vite-shared.ts"]
}
VITE_API_URL=http://localhost:8080
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=local
VITE_SENTRY_RELEASE=local-dev

ORVAL_OPENAPI_URL=http://localhost:8080/docs/api.json

# Docker private
NODE_ENV=development
PORT=3000
STORYBOOK_PORT=6006
CHOKIDAR_USEPOLLING=true

# Reverb websocket target as seen from the browser (#254). Leave VITE_REVERB_APP_KEY empty to
# run without a socket; processing status then falls back to polling. Values are the public
# app key and the host/port the browser can reach, NOT the backend's bind address.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8081
VITE_REVERB_SCHEME=http

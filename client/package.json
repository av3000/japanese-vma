{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --port 3000 --strictPort",
    "dev:docker": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "build:analyze": "vite build --mode analyze",
    "orval": "node --env-file=.env ./node_modules/orval/dist/bin/orval.mjs --config ./orval/orval.config.js",
    "orval:file": "node ./node_modules/orval/dist/bin/orval.mjs --config ./orval/orval.config.js",
    "orval:live": "node --env-file=.env ./node_modules/orval/dist/bin/orval.mjs --config ./orval/orval.config.js",
    "orval:dev": "node --env-file=.env ./node_modules/orval/dist/bin/orval.mjs --config ./orval/orval.config.js",
    "orval:article": "node --env-file=.env ./node_modules/orval/dist/bin/orval.mjs --config ./orval/orval.config.js",
    "orval:catalogue": "node --env-file=.env ./node_modules/orval/dist/bin/orval.mjs --config ./orval/orval.config.js",
    "api:generate": "cd ../processor-api && composer openapi && cd ../client && npm run orval:file && npm run typecheck",
    "preview": "vite preview",
    "storybook:docker": "storybook dev -p 6006 --host 0.0.0.0 --no-open",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint ./**/*.{ts,tsx} --fix",
    "format": "prettier --log-level error --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:storybook": "vitest run --project storybook",
    "style:audit": "node scripts/style-audit.mjs",
    "story:audit": "node scripts/story-audit.mjs",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:all": "vitest run"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@sentry/react": "^10.43.0",
    "@tanstack/react-query": "^5.90.16",
    "@tanstack/react-query-devtools": "^5.91.2",
    "axios": "^1.6.7",
    "classnames": "^2.5.1",
    "date-fns": "^4.1.0",
    "laravel-echo": "^2.2.7",
    "lucide-react": "^0.563.0",
    "pusher-js": "^8.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.55.0",
    "react-router-dom": "^6.22.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@faker-js/faker": "10.6.0",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@tanstack/eslint-plugin-query": "^5.72.2",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^22.13.11",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser-playwright": "5.0.4",
    "@vitest/coverage-v8": "5.0.4",
    "eslint-config-prettier": "^10.1.2",
    "eslint-import-resolver-typescript": "^4.3.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-storybook": "10.6.2",
    "eslint-plugin-vitest": "^0.5.4",
    "globals": "^16.0.0",
    "jsdom": "^30.0.1",
    "msw": "2.15.0",
    "msw-storybook-addon": "3.0.3",
    "orval": "^8.6.2",
    "playwright": "1.64.0",
    "prettier": "^3.5.3",
    "prop-types": "^15.8.1",
    "remark-gfm": "4.0.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "storybook": "10.6.2",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.29.1",
    "vite": "^6.2.1",
    "vite-plugin-checker": "^0.9.1",
    "vitest": "5.0.4"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
